Package: mixedFlowR
Type: Package
Title: Design-Aware Mixed Models for Agronomic Experiments
Version: 0.1.0.9000
Authors@R: c(
    person(given = "Walter", family = "Esfrain Pereira",
           email = "walterufpb@yahoo.com.br",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0003-1085-0191")),
