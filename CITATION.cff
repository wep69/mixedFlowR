    given-names: "Magali Haidee"
    orcid: "https://orcid.org/0009-0009-5419-959X"
license: GPL-3.0-or-later
keywords:
  - mixed models
  - experimental design
  - agronomy
  - split-plot
  - reproducible research
  - R
